# ============================================
# JobTrust - Environment Variables
# ============================================
# Copy this file to .env and fill in your keys:
#   copy .env.example .env
#
# Get a FREE Gemini API key at:
#   https://aistudio.google.com/app/apikey
# ============================================

# Gemini API (FREE - Recommended)
GEMINI_API_KEY=your-gemini-api-key-here

# OpenAI API (Paid - Optional)
# OPENAI_API_KEY=sk-your-openai-key-here

# WHOIS XML API (for real domain age/trust — 500 free lookups)
# Get a key at: https://whoisxmlapi.com
# WHOIS_API_KEY=your-whois-api-key-here

# LinkedIn API (Optional - for Phase 2 graph features)
# LINKEDIN_API_KEY=your-linkedin-key-here

# Glassdoor API (Optional - for Phase 2 graph features)
# GLASSDOOR_API_KEY=your-glassdoor-key-here
